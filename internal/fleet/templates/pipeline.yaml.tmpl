# ci/pipelines/{{.Name}}.yaml — build/deploy pipeline wiring for {{.Name}}.
# Consumed by fleet doctor / the pipeline blocks. Targets mirror
# ops/ENVIRONMENTS.yaml; prod applies are VM-tier only.

component: {{.Name}}
language: go
build_block: scripts/blocks/03-pipeline.sh
manifests_dir: {{.Manifests}}
gates_file: lifecycle/gates.yaml
targets:
  dev:
    mode: dryrun-client
  stage:
    mode: dryrun-client
  prod:
    mode: cluster-apply
    note: VM tier only
