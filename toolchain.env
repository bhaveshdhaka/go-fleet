# fleet toolchain manifest — single source of truth for every pinned version.
# Consumed by scripts/blocks/*.sh and asserted by tests (C1*).
# Format: TOOLCHAIN_<TOOL>_VERSION="<exact-pin>"  (one per line, KEY="VALUE").

export TOOLCHAIN_GO_VERSION="1.27.0"
export TOOLCHAIN_BUN_VERSION="1.4.0"
export TOOLCHAIN_TEMPL_VERSION="v0.3.1020"
export TOOLCHAIN_TAILWIND_VERSION="4.3.3"
export TOOLCHAIN_DAGGER_VERSION="0.16.2"
export TOOLCHAIN_KUBECTL_VERSION="v1.36.3"
export TOOLCHAIN_ARGOCD_VERSION="v2.14.2"
export TOOLCHAIN_KUBESEAL_VERSION="v0.30.0"
export TOOLCHAIN_RESTIC_VERSION="0.17.3"
export TOOLCHAIN_OPENCHAMBER_VERSION="0.9.0"
export TOOLCHAIN_OPENCODE_VERSION="0.13.1"

export TOOLCHAIN_ARCH="amd64"
export TOOLCHAIN_OS="linux"
