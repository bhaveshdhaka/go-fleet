#!/usr/bin/env bash
# scripts/fleet — control-plane entrypoint (WO-4: thin shim over the Go core).
# The logic lives in cmd/fleet; this shim guarantees a fresh byte-reproducible
# binary (ci/build-fleet.sh, pinned toolchain, GOPROXY=off) and pins
# FLEET_ROOT so the binary NEVER resolves the repo by walking up from its
# own location (rule-7 discipline: no ambient resolution, ever).

set -uo pipefail
FLEET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FLEET_ROOT
BIN="$FLEET_ROOT/dist/fleet"

stale() {
  [[ -x "$BIN" ]] || return 0
  local newer
  newer="$(find "$FLEET_ROOT/go.mod" "$FLEET_ROOT/cmd" "$FLEET_ROOT/internal" \
    "$FLEET_ROOT/ci/build-fleet.sh" "$FLEET_ROOT/toolchain.env" \
    -newer "$BIN" -print -quit 2>/dev/null)"
  [[ -n "$newer" ]]
}

if stale; then
  bash "$FLEET_ROOT/ci/build-fleet.sh" "$BIN" >/dev/null || exit 1
fi

exec "$BIN" "$@"
